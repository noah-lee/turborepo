{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "ignore": ["dist", "build", ".turbo", "apps/web/src/routeTree.gen.ts"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "overrides": [
    {
      "include": ["apps/web/**"],
      "javascript": {
        "formatter": {
          "quoteStyle": "double",
          "semicolons": "asNeeded"
        }
      }
    },
    {
      "include": ["apps/web/src/components/ui/**"],
      "linter": {
        "rules": {
          "security": { "noDangerouslySetInnerHtml": "off" },
          "suspicious": { "noArrayIndexKey": "off" }
        }
      }
    }
  ],
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}
